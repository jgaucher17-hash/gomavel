---
/**
 * LA PISTE DE L'ACCUEIL — sa demande du 12/10 au soir : des ninjas « qui marchent, qui
 * sautent de l'écran, qui reviennent ». Avant, six images fixes ; sur téléphone rien ne
 * bougeait (le saut n'existait qu'au survol d'une souris).
 *
 * Chaque ninja est une BANDE de 15 images tirées du vrai rig du jeu (12 de course, 3 de
 * saut : `ninja-runner/tools/site-coureurs.js`, puis `outils/coureurs.mjs`), vue à
 * travers une fenêtre d'une image. Sans script, ils restent alignés sur le filet, en
 * première image de course : la page est complète. Le mouvement est dans
 * `scripts/piste.js`. Les huit skins 100 % originaux seulement (cf. produits/shuriken-storm.js).
 */
const bandes = import.meta.glob('../assets/coureurs/*.webp', { eager: true, query: '?url', import: 'default' });
const ORDRE = ['kage', 'kurenai', 'raijin', 'aoi', 'tengu', 'ronin', 'yorumaru', 'kagerou'];
const coureurs = ORDRE.map((id) => ({ id, src: bandes[`../assets/coureurs/${id}.webp`] })).filter((c) => c.src);
---
<div class="piste conteneur" aria-hidden="true" data-piste>
  <div class="piste-sol">
    {coureurs.map((c) => (
      <div class="coureur" data-coureur><img src={c.src} alt="" width="2250" height="180" decoding="async" /></div>
    ))}
  </div>
</div>
<script>
  import '../scripts/piste.js';
</script>
