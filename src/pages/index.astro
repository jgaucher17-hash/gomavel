---
/**
 * L'ACCUEIL — le studio, et lui seul.
 *
 * Sa demande du 12/10 au soir : « pas de capture d'écran du jeu dans l'accueil, que des
 * petits skins ou éléments du jeu détourés » et « quand on arrive sur le site on ne doit
 * pas voir Shuriken Storm direct, on doit cliquer sur son onglet ».
 *
 * Puis, le même soir : « trop de texte inutile […] comble pas pour rien mettre. Trouve de
 * la vraie matière […] et si tu sais pas, tu mets rien, ça arrivera au fur et à mesure,
 * avec les autres jeux ». Sont partis : « Applications et jeux mobiles », la phrase de
 * présentation, toute la bande « Le studio » (« Peu de produits… », ses deux paragraphes,
 * « Petit écran » et « Les chances affichées ») et le renvoi vers les nouveautés (le menu
 * y mène). Reste l'accroche et les ninjas qui courent : ce qui s'ajoutera ici, ce sont
 * les prochains produits, pas des phrases.
 */
import Base from '../layouts/Base.astro';
import Piste from '../components/Piste.astro';
import { SITE } from '../data/site.js';

/* L'accroche sur deux lignes, coupée avant son dernier mot : « Un autre / level. » —
   le mot qui rime avec GomaVEL tombe seul, en bas, au-dessus des ninjas. */
const coupe = SITE.accroche.lastIndexOf(' ');
const lignes = coupe > 0 ? [SITE.accroche.slice(0, coupe), SITE.accroche.slice(coupe + 1)] : [SITE.accroche];

const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Gomavel',
  url: SITE.url + '/',
  logo: SITE.url + '/icon-512.png',
  description: SITE.description,
  foundingDate: String(SITE.fondation),
  slogan: SITE.accroche,
};
---
<Base titre={`Gomavel — ${SITE.accroche}`} classe="accueil" jsonld={jsonld}>
  <!-- L'accroche en haut, la piste en bas : à elles deux, le premier écran (la page n'a
       plus assez de texte pour que le pied de page tombe sous le pli tout seul). -->
  <div class="scene">
    <section class="ouverture conteneur" aria-labelledby="t-accroche">
      <h1 id="t-accroche" class="accroche">
        {lignes.map((l) => <span class="ligne"><span>{l}</span></span>)}
      </h1>
    </section>
    <Piste />
  </div>

  {SITE.emails.studio && (
    <section id="contact" class="contact conteneur" aria-labelledby="t-contact">
      <p class="label doux" id="t-contact">Contact</p>
      <a class="adresse lien" href={`mailto:${SITE.emails.studio}`}>{SITE.emails.studio}</a>
    </section>
  )}
</Base>
