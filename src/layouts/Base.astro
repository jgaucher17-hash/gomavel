---
/**
 * LE GABARIT DE TOUTES LES PAGES.
 *
 * Aucune ressource tierce : la police, les images et les scripts sont servis par le site
 * (l'en-tête CSP de `public/_headers` le garantit). Aucun cookie, aucun traceur.
 */
import '@fontsource-variable/archivo/wdth.css';
import '../styles/global.css';
import police from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import Entete from '../components/Entete.astro';
import Pied from '../components/Pied.astro';
import { SITE } from '../data/site.js';

const {
  titre,
  description = SITE.description,
  image = '/og/gomavel.png',
  classe = '',
  jsonld = null,
  indexer = true,
  /* L'identifiant d'un élément que la page doit avoir lu avant sa première image : la
     transition entre pages (le cadre qui s'ouvre) a besoin de le trouver à l'arrivée. */
  attendu = null,
} = Astro.props;

const canonique = new URL(Astro.url.pathname, SITE.url).href;
const imageAbsolue = new URL(image, SITE.url).href;
const robots = SITE.indexable && indexer ? 'index, follow' : 'noindex, nofollow';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <!-- Propriété de gomavel.com dans la Search Console (jgaucher17), exigée par la Play Console
         pour valider le site de l'organisation (21/10/2026). Ne pas retirer : Google revérifie. -->
    <meta name="google-site-verification" content="P-H1jhKMV651Cjn0m63M60yRtwyBF565Un0bVl5VK3w" />
    <link rel="canonical" href={canonique} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={police} as="font" type="font/woff2" crossorigin />
    {attendu && <link rel="expect" href={`#${attendu}`} blocking="render" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Gomavel" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    <meta property="og:image" content={imageAbsolue} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <script is:inline src="/vt.js"></script>
  </head>
  <body class={classe}>
    <a class="evitement" href="#contenu">Aller au contenu</a>
    <Entete />
    <main id="contenu">
      <slot />
    </main>
    <Pied />
    <script>
      import '../scripts/site.js';
    </script>
  </body>
</html>
